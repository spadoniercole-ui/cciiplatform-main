{
  "name": "cciiplatform",
  "version": "0.116.2",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 4028",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start",
    "check:use-server": "bash scripts/check-use-server-exports.sh",
    "type-check": "npm run check:use-server && npm run check:autorizzazione && tsc --noEmit",
    "db:push": "drizzle-kit push",
    "build": "next build",
    "build:portable": "node portable/build-portable.mjs",
    "test": "vitest run",
    "check:autorizzazione": "node scripts/check-autorizzazione.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electric-sql/pglite": "^0.5.4",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^2.4.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.10.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.7.0",
    "next": "^15.5.26",
    "node-forge": "^1.4.0",
    "pg": "^8.22.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "recharts": "^2.15.2",
    "sonner": "^1.7.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "10.4.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "tailwindcss": "3.4.6",
    "typescript": "^5",
    "vitest": "^2.1.9"
