# server/.env.example — copiare in server/.env e compilare.
# Il file .env contiene segreti: leggibile solo dall'amministratore
# (chmod 600 .env) e mai committato.

# --- Database (Postgres nel container "db") ---------------------------------
# Solo lettere e cifre (finisce in un URL). Generabile con: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Superadmin (non sta nel database) --------------------------------------
SUPERADMIN_USER=superadmin
# Almeno 16 caratteri. Al primo accesso verrà chiesto di impostare il PIN/MFA.
SUPERADMIN_PASSWORD=

# --- Intelligenza artificiale (facoltativa) ---------------------------------
# Senza chiave le funzioni AI (relazione, visure, screening, chatbot)
# restituiscono un errore; il resto della piattaforma funziona.
# Il server deve poter raggiungere https://api.anthropic.com.
ANTHROPIC_API_KEY=

# --- HTTPS --------------------------------------------------------------------
# Nomi e/o IP con cui gli utenti raggiungono il server, separati da virgola.
CCII_INDIRIZZI=ccii.ente.local, 192.168.1.50
# "internal" = certificato della CA locale di Caddy (va installata sui PC,
# vedi la guida). Con il certificato dell'IT, copiare cert.pem (catena
# completa) e key.pem in server/certificati/ e scrivere:
# CCII_TLS=/certificati/cert.pem /certificati/key.pem
CCII_TLS=internal
CCII_PORTA_HTTP=80
CCII_PORTA_HTTPS=443

# --- Backup pianificato del database ----------------------------------------
# Cartella del server in cui scrivere i backup (includerla nel backup
# aziendale / copiarla su un altro disco).
CCII_CARTELLA_BACKUP=./backup
BACKUP_ORA=02:00
BACKUP_GIORNI_CONSERVAZIONE=30

# --- Varie ------------------------------------------------------------------
TZ=Europe/Rome
NEXT_PUBLIC_COPYRIGHT=
