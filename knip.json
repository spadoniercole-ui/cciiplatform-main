{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,error,not-found,loading}.{ts,tsx}",
    "scripts/*.mjs",
    "**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/*.mjs", "portable/*.mjs"],
  "ignoreDependencies": [
    "eslint",
    "@eslint/eslintrc",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "eslint-config-next",
    "eslint-config-prettier",
    "eslint-plugin-prettier"
  ]
}
