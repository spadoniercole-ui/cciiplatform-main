# Copia questo file in .env e valorizza le chiavi reali.
# .env è (ora) escluso da .gitignore: non deve mai essere committato.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Usata da src/app/api/xbrl/report-ai/route.ts per generare la Relazione AI.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
PERPLEXITY_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=

# Copyright mostrato nel login e nelle pagine del programma (barra di stato).
# {year} viene sostituito con l'anno corrente. Se vuoto si usa il default nel
# codice (© {year} Ercole Spadoni — Tutti i diritti riservati).
NEXT_PUBLIC_COPYRIGHT=© {year} Ercole Spadoni — Tutti i diritti riservati

DATABASE_URL=
POSTGRES_URL=

# Password del superadmin di sistema (unico utente, vedi src/app/actions/auth.ts).
# Cambiarla e non lasciarla mai al valore di default.
SUPERADMIN_PASSWORD=
SUPERADMIN_USER=superadmin

# Soglia di tolleranza massima in Euro per anomalie di quadratura XBRL
XBRL_TOLERANCE_THRESHOLD=
